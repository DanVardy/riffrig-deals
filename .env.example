# Placeholders only. Do not put real secrets in git.
# Generate long random values locally when you are ready:
#   openssl rand -base64 32

DATABASE_URL=
# Set to require for a public Postgres URL that needs TLS.
# Leave empty for a local database without TLS.
DATABASE_SSL=

# Server-only. Never prefix with NEXT_PUBLIC.
ADMIN_TOKEN=
UNSUBSCRIBE_SECRET=

# Public site origin used for canonical links. No trailing path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search indexing is off unless this is exactly true.
# Set it for the production build and the running process before launch.
# The build writes the X-Robots-Tag header. Page metadata and /robots.txt
# read the same flag when a request is served.
ALLOW_SEARCH_INDEXING=false

# Leadmail is disabled unless every value below is set AND
# LEADMAIL_SENDING_VERIFIED=true after the owner confirms the real API host.
# Docs examples use a broken host (https:///api). Do not guess one here.
LEADMAIL_API_BASE=
LEADMAIL_API_KEY=
LEADMAIL_LIST_ID=
LEADMAIL_SENDING_VERIFIED=false
